{
    "name": "roicore/roicore",
    "description": "ROiCORE — Flood Intelligence Platform (OOP & OOAD)",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "ROiCORE Team"
        }
    ],
    "require": {
        "php": ">=8.2",
        "guzzlehttp/guzzle": "^7.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "RoiCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoiCore\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
